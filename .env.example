# --- Påkrevd ---
# Google AI Studio / Gemini API-nøkkel. Brukes KUN på serveren (aldri i nettleseren).
GEMINI_API_KEY=

# --- Valgfritt: modellvalg ---
# Standard: Nano Banana 2.1 (GA okt 2026). Fallback brukes hvis primærmodellen feiler/er overbelastet.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
# Tekstmodell for ekstra innholdssjekk av forslag (barnevennlighet). Tom = kun ordliste.
GEMINI_SAFETY_MODEL=gemini-3.1-flash-lite

# --- Valgfritt: Kunstveggen (felles galleri) + rate limiting ---
# Settes automatisk når du kobler Vercel Blob og Upstash Redis (Marketplace) til prosjektet.
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Moderering: delte bilder må godkjennes i /admin før de vises (anbefalt for barn).
GALLERY_AUTO_APPROVE=false
ADMIN_TOKEN=

# Maks antall genereringer per enhet per time (krever Redis).
RATE_LIMIT_PER_HOUR=20
